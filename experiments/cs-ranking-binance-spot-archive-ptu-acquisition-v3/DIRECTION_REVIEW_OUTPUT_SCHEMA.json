{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "experiment_id",
    "verdict",
    "source_commit",
    "draft_sha256",
    "scope",
    "confirmed",
    "checks",
    "required_revisions",
    "limitations",
    "market_data_accessed",
    "network_accessed",
    "holdout_accessed",
    "strategy_returns_calculated",
    "performance_claim_made",
    "implementation_authorized"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "experiment_id": {"const": "cs-ranking-binance-spot-archive-ptu-acquisition-v3"},
    "verdict": {"enum": ["DIRECTION_ACCEPTED", "REVISION_REQUIRED"]},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "draft_sha256": {"const": "144d795799304945e115b9006d54fc6490b31dc00c3c0e485094980bbab21c0e"},
    "scope": {"type": "string", "minLength": 1},
    "confirmed": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "checks": {
      "type": "array",
      "minItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check", "status", "finding"],
        "properties": {
          "check": {"type": "string", "minLength": 1},
          "status": {"enum": ["PASS", "FAIL", "LIMITATION"]},
          "finding": {"type": "string", "minLength": 1}
        }
      }
    },
    "required_revisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "clause", "problem", "exact_required_change", "rationale"],
        "properties": {
          "severity": {"enum": ["major", "minor"]},
          "clause": {"type": "string", "minLength": 1},
          "problem": {"type": "string", "minLength": 1},
          "exact_required_change": {"type": "string", "minLength": 1},
          "rationale": {"type": "string", "minLength": 1}
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "market_data_accessed": {"const": false},
    "network_accessed": {"const": false},
    "holdout_accessed": {"const": false},
    "strategy_returns_calculated": {"const": false},
    "performance_claim_made": {"const": false},
    "implementation_authorized": {"const": false}
  },
  "allOf": [
    {
      "if": {"properties": {"verdict": {"const": "DIRECTION_ACCEPTED"}}},
      "then": {"properties": {"required_revisions": {"maxItems": 0}}}
    },
    {
      "if": {"properties": {"verdict": {"const": "REVISION_REQUIRED"}}},
      "then": {"properties": {"required_revisions": {"minItems": 1}}}
    }
  ]
}
