[Unit]
Description=Read-only crypto strategy control refresh

[Service]
Type=oneshot
WorkingDirectory=%h/crypto-strategy-control
Environment=PYTHONPATH=%h/crypto-strategy-control/src
ExecStart=/usr/bin/python3 -m strategy_control refresh
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=%h/crypto-strategy-control/reports
