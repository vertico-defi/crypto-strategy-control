{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "program", "phase", "capital_permitted", "holdout_access",
    "usage_paused", "website_external_lock"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "program": {"const": "RegimeMoE"},
    "phase": {"type": "integer", "minimum": 0},
    "capital_permitted": {"const": 0},
    "holdout_access": {"const": "FORBIDDEN"},
    "usage_paused": {"type": "boolean"},
    "retry_after_utc": {"type": "string"},
    "gpu_phase_0": {"const": false},
    "timers_enabled": {"type": "boolean"},
    "automation_state": {"enum": ["ACTIVE", "PAUSED_FOR_ADAPTER_HARDENING", "AUTOMATION_STATE_DRIFT", "SUPERVISED_MANUAL_RESEARCH"]},
    "current_milestone": {"type": "string", "minLength": 1},
    "g1_v2": {"type": "object", "additionalProperties": false, "required": ["authorization_id", "result", "next_state", "review_verdict"], "properties": {"authorization_id": {"const": "G1-v2-frozen-protocol-conformance"}, "result": {"const": "G1_V2_PROTOCOL_CONFORMANCE_PASS"}, "next_state": {"const": "READY_FOR_SUPERVISED_DEVELOPMENT_SAMPLE_AUTHORIZATION"}, "review_verdict": {"const": "PASS"}}},
    "g1_v2_environment": {"type": "object", "additionalProperties": false, "required": ["result", "full_validation", "report"], "properties": {"result": {"const": "G1_V2_REPRODUCIBLE_ENVIRONMENT_PASS"}, "full_validation": {"const": "G1_V2_FULL_VALIDATION_PASS"}, "report": {"const": "regime-moe-lab/artifacts/g1-v2-reproducible-environment-report.json"}}},
    "g1_v2_development_integration": {"type": "object", "additionalProperties": false, "required": ["authorization_id", "result", "artifact"], "properties": {"authorization_id": {"const": "G1-v2-development-only-integration-sample"}, "result": {"const": "G1_V2_INTERVAL_SELECTION_EVIDENCE_INSUFFICIENT"}, "artifact": {"const": "regime-moe-lab/artifacts/g1-v2-development-integration-insufficiency.json"}}},
    "g1_v2_1": {"type":"object","additionalProperties":false,"required":["amendment_id","result","artifact"],"properties":{"amendment_id":{"const":"G1-v2.1-interval-selection-evidence-protocol"},"result":{"const":"G1_V2_1_INCREMENTAL_COMPLETION_EXHAUSTED"},"artifact":{"const":"regime-moe-lab/artifacts/g1-v21-incremental-completion-exhausted.json"}}},
    "g1_v2_2":{"type":"object","additionalProperties":false,"required":["authorization_id","result","artifact"],"properties":{"authorization_id":{"const":"G1-v2.2-fixed-one-hour-decision-protocol"},"result":{"const":"G1_V2_2_FIXED_ONE_HOUR_PROTOCOL_FAILED"},"artifact":{"const":"regime-moe-lab/artifacts/g1-v22-fixed-one-hour-protocol-validation.json"}}},
    "automation_pause": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paused_by", "reason", "at_utc", "service_unit", "timer_unit"],
      "properties": {
        "paused_by": {"type": "string"},
        "reason": {"type": "string"},
        "at_utc": {"type": "string"},
        "service_unit": {"type": "string"},
        "timer_unit": {"type": "string"}
      }
    },
    "last_cycle_at_utc": {"type": "string"},
    "production_adapters_active": {"type": "array", "items": {"type": "string"}},
    "g0_foundation_pass": {
      "type": "object",
      "additionalProperties": false,
      "required": ["control_commit", "lab_commit", "model", "reasoning", "verdict"],
      "properties": {
        "control_commit": {"type": "string", "minLength": 1},
        "lab_commit": {"type": "string", "minLength": 1},
        "model": {"const": "gpt-5.6-sol"},
        "reasoning": {"const": "high"},
        "verdict": {"const": "PASS"}
      }
    },
    "website_external_lock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "branch", "status"],
      "properties": {
        "repository": {"type": "string"},
        "branch": {"type": "string"},
        "status": {
          "enum": [
            "EXTERNALLY_LOCKED_UNTIL_MERGED_AND_EXPLICITLY_CLEARED",
            "WEBSITE_AVAILABLE_FOR_SANITIZED_PUBLICATION_TASKS"
          ]
        },
        "verified_at_utc": {"type": "string"},
        "verified_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "validation_workflow": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "run_id"],
          "properties": {
            "status": {"const": "SUCCESS"},
            "run_id": {"type": "integer", "minimum": 1}
          }
        },
        "pages_deployment": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "run_id"],
          "properties": {
            "status": {"const": "SUCCESS"},
            "run_id": {"type": "integer", "minimum": 1}
          }
        },
        "safety_flags": {
          "type": "object",
          "additionalProperties": false,
          "required": ["store_live", "payments_live", "newsletter_live"],
          "properties": {
            "store_live": {"const": false},
            "payments_live": {"const": false},
            "newsletter_live": {"const": false}
          }
        },
        "authorized_scope": {"const": "SANITIZED_EVIDENCE_UPDATES_ONLY"},
        "prohibited_actions": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string"}
        }
      }
    }
  }
}
